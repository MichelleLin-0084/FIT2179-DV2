{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "State damage ranking — lollipop chart",
  "width": "container",
  "height": 320,
  "data": {
    "values": [
      {"state": "QLD", "state_full": "Queensland",                   "damage": 28.4, "events": 55, "zero": 0, "note": "Frequent cyclones and flooding across the north and south-east"},
      {"state": "NSW", "state_full": "New South Wales",              "damage": 22.7, "events": 70, "zero": 0, "note": "Highest event count — flood-prone river systems and wildfire risk"},
      {"state": "VIC", "state_full": "Victoria",                     "damage": 14.3, "events": 33, "zero": 0, "note": "Black Saturday fires and 2010 floods caused major losses"},
      {"state": "WA",  "state_full": "Western Australia",            "damage":  6.2, "events": 14, "zero": 0, "note": "Cyclones in the north; drought in agricultural regions"},
      {"state": "SA",  "state_full": "South Australia",              "damage":  4.8, "events":  8, "zero": 0, "note": "Drought and heatwave exposure; lower event frequency"},
      {"state": "NT",  "state_full": "Northern Territory",           "damage":  1.9, "events":  6, "zero": 0, "note": "Tropical cyclones and flooding in the wet season"},
      {"state": "TAS", "state_full": "Tasmania",                     "damage":  0.8, "events":  9, "zero": 0, "note": "Bushfires and flooding; relatively lower economic impact"},
      {"state": "ACT", "state_full": "Australian Capital Territory", "damage":  0.3, "events":  3, "zero": 0, "note": "Smallest territory; affected by Canberra bushfires in 2003"}
    ]
  },
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 2.5, "opacity": 0.6, "color": "#E69F00"},
      "encoding": {
        "y": {
          "field": "state", "type": "ordinal", "title": null, "sort": "-x",
          "axis": {"labelFontSize": 14, "labelFont": "DM Sans", "labelFontWeight": "500", "labelColor": "#F5F0E8", "domainColor": "transparent", "tickColor": "transparent"}
        },
        "x":  {"field": "zero",   "type": "quantitative"},
        "x2": {"field": "damage", "type": "quantitative"}
      }
    },
    {
      "mark": {"type": "circle", "filled": true, "size": 180, "tooltip": true},
      "encoding": {
        "y": {
          "field": "state", "type": "ordinal", "title": null, "sort": "-x",
          "axis": {"labelFontSize": 14, "labelFont": "DM Sans", "labelFontWeight": "500", "labelColor": "#F5F0E8", "domainColor": "transparent", "tickColor": "transparent"}
        },
        "x": {
          "field": "damage", "type": "quantitative",
          "title": "Total damage (billion USD, inflation-adjusted)",
          "scale": {"domainMax": 35},
          "axis": {"labelFontSize": 11, "labelFont": "DM Sans", "titleFontSize": 11, "titleFont": "DM Sans", "titleColor": "#aab0c0", "gridColor": "rgba(255,255,255,0.08)", "domainColor": "transparent", "labelColor": "#aab0c0"}
        },
        "color": {
          "field": "damage", "type": "quantitative",
          "scale": {"scheme": "oranges", "domainMin": 0, "domainMax": 30},
          "legend": {
            "title": "Damage (B USD)",
            "titleFontSize": 10,
            "titleColor": "#aab0c0",
            "labelFontSize": 10,
            "labelFont": "DM Sans",
            "labelColor": "#F5F0E8",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 140,
            "gradientThickness": 10
          }
        },
        "tooltip": [
          {"field": "state_full", "type": "nominal",      "title": "State"},
          {"field": "damage",     "type": "quantitative", "title": "Damage (billion USD)", "format": ".1f"},
          {"field": "events",     "type": "quantitative", "title": "Total events"},
          {"field": "note",       "type": "nominal",      "title": "Context"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 10, "dy": -8, "fontSize": 12, "fontWeight": "500", "font": "DM Sans", "color": "#F5F0E8"},
      "encoding": {
        "y": {"field": "state",  "type": "ordinal", "sort": "-x"},
        "x": {"field": "damage", "type": "quantitative"},
        "text": {"field": "damage", "type": "quantitative", "format": ".1f"}
      }
    }
  ],
  "view": {"stroke": null},
  "background": "transparent",
  "config": {"font": "DM Sans"}
}
