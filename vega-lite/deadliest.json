{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Top 10 deadliest events — lollipop chart",
  "width": "container",
  "height": 340,
  "data": {
    "values": [
      {"label": "2009 Heatwave (VIC/TAS)",       "disaster_type": "Extreme temperature", "year": 2009, "deaths": 347, "zero": 0, "note": "Deadliest heatwave on record in Australia"},
      {"label": "Black Saturday fires (VIC)",     "disaster_type": "Wildfire",            "year": 2009, "deaths": 180, "zero": 0, "note": "Australia's deadliest peacetime disaster"},
      {"label": "2014 Heatwave (WA/VIC)",         "disaster_type": "Extreme temperature", "year": 2014, "deaths": 139, "zero": 0, "note": "Prolonged extreme heat across two states"},
      {"label": "2010 Floods (NSW/QLD/VIC)",      "disaster_type": "Flood",               "year": 2010, "deaths":  35, "zero": 0, "note": "Widespread flooding across eastern Australia"},
      {"label": "Currowan fires (NSW/VIC)",       "disaster_type": "Wildfire",            "year": 2019, "deaths":  32, "zero": 0, "note": "Part of the 2019-20 Black Summer fires"},
      {"label": "2022 Floods (QLD/NSW)",          "disaster_type": "Flood",               "year": 2022, "deaths":  22, "zero": 0, "note": "Catastrophic east coast flooding event"},
      {"label": "TC Debbie (QLD/NSW)",            "disaster_type": "Storm",               "year": 2017, "deaths":  12, "zero": 0, "note": "Category 4 cyclone causing widespread damage"},
      {"label": "2005 Eyre Peninsula fires (SA)", "disaster_type": "Wildfire",            "year": 2005, "deaths":  12, "zero": 0, "note": "Fast-moving fire in South Australia"},
      {"label": "2023 Storms (NSW/QLD/VIC)",      "disaster_type": "Storm",               "year": 2023, "deaths":  10, "zero": 0, "note": "Severe storm system across eastern states"},
      {"label": "2007 Floods (NSW)",              "disaster_type": "Flood",               "year": 2007, "deaths":   9, "zero": 0, "note": "Flash flooding in the Hunter Valley"}
    ]
  },
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 2, "opacity": 0.6},
      "encoding": {
        "y": {
          "field": "label", "type": "ordinal", "title": null, "sort": "-x",
          "axis": {"labelFontSize": 11, "labelFont": "DM Sans", "labelColor": "#F5F0E8", "domainColor": "transparent", "tickColor": "transparent", "labelLimit": 230}
        },
        "x":  {"field": "zero",   "type": "quantitative"},
        "x2": {"field": "deaths", "type": "quantitative"},
        "color": {
          "field": "disaster_type", "type": "nominal",
          "scale": {
            "domain": ["Flood","Storm","Wildfire","Extreme temperature"],
            "range":  ["#0072B2","#56B4E9","#E69F00","#CC79A7"]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {"type": "circle", "filled": true, "size": 120, "tooltip": true},
      "encoding": {
        "y": {
          "field": "label", "type": "ordinal", "title": null, "sort": "-x",
          "axis": {"labelFontSize": 11, "labelFont": "DM Sans", "labelColor": "#F5F0E8", "domainColor": "transparent", "tickColor": "transparent", "labelLimit": 230}
        },
        "x": {
          "field": "deaths", "type": "quantitative",
          "title": "Deaths",
          "scale": {"domainMax": 390},
          "axis": {"labelFontSize": 11, "labelFont": "DM Sans", "titleFontSize": 11, "titleFont": "DM Sans", "titleColor": "#aab0c0", "gridColor": "rgba(255,255,255,0.08)", "domainColor": "transparent", "labelColor": "#aab0c0"}
        },
        "color": {
          "field": "disaster_type", "type": "nominal",
          "scale": {
            "domain": ["Flood","Storm","Wildfire","Extreme temperature"],
            "range":  ["#0072B2","#56B4E9","#E69F00","#CC79A7"]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "horizontal",
            "labelFontSize": 11,
            "labelFont": "DM Sans",
            "labelColor": "#F5F0E8",
            "symbolSize": 150,
            "padding": 6
          }
        },
        "tooltip": [
          {"field": "label",        "type": "nominal",      "title": "Event"},
          {"field": "disaster_type","type": "nominal",      "title": "Type"},
          {"field": "year",         "type": "quantitative", "title": "Year"},
          {"field": "deaths",       "type": "quantitative", "title": "Deaths"},
          {"field": "note",         "type": "nominal",      "title": "Note"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 8, "dy": -8, "fontSize": 11, "fontWeight": "500", "font": "DM Sans", "color": "#F5F0E8"},
      "encoding": {
        "y": {"field": "label",  "type": "ordinal", "sort": "-x"},
        "x": {"field": "deaths", "type": "quantitative"},
        "text": {"field": "deaths", "type": "quantitative"}
      }
    }
  ],
  "view": {"stroke": null},
  "background": "transparent",
  "config": {"font": "DM Sans"}
}
