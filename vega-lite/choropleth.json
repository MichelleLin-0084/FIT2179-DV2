{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map of Australian natural disaster events by state, 2000-2026",
  "width": "container",
  "height": 500,
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 750
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/alwaysblazing/Australia-State-TopoJson-MapChart/master/au-states-topo.json",
        "format": {
          "type": "topojson",
          "feature": "austates"
        }
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {
              "values": [
                {"id": 0, "state": "Western Australia",            "event_count": 14},
                {"id": 1, "state": "Queensland",                   "event_count": 55},
                {"id": 2, "state": "New South Wales",              "event_count": 70},
                {"id": 3, "state": "Victoria",                     "event_count": 33},
                {"id": 4, "state": "South Australia",              "event_count":  8},
                {"id": 5, "state": "Tasmania",                     "event_count":  9},
                {"id": 6, "state": "Northern Territory",           "event_count":  6},
                {"id": 7, "state": "Australian Capital Territory", "event_count":  3}
              ]
            },
            "key": "id",
            "fields": ["state", "event_count"]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.5,
        "tooltip": true
      },
      "encoding": {
        "color": {
          "field": "event_count",
          "type": "quantitative",
          "title": "Events",
          "scale": {
            "scheme": "oranges",
            "domainMin": 0,
            "domainMax": 75
          },
          "legend": {
            "title": "Disaster events",
            "titleFontSize": 12,
            "titleFont": "DM Sans",
            "labelFontSize": 11,
            "labelFont": "DM Sans",
            "labelColor": "#F5F0E8",
            "titleColor": "#F5F0E8",
            "orient": "bottom-right",
            "direction": "horizontal",
            "gradientLength": 160,
            "gradientThickness": 12
          }
        },
        "tooltip": [
          {"field": "state",       "type": "nominal",      "title": "State"},
          {"field": "event_count", "type": "quantitative", "title": "Disaster events"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"state": "NSW\n70",  "lon": 146.5, "lat": -32.0, "dark": true},
          {"state": "QLD\n55",  "lon": 144.5, "lat": -22.0, "dark": true},
          {"state": "VIC\n33",  "lon": 144.8, "lat": -37.0, "dark": false},
          {"state": "WA\n14",   "lon": 122.0, "lat": -27.0, "dark": false},
          {"state": "SA\n8",    "lon": 135.5, "lat": -30.0, "dark": false},
          {"state": "TAS\n9",   "lon": 146.5, "lat": -42.0, "dark": false},
          {"state": "NT\n6",    "lon": 133.5, "lat": -19.5, "dark": false},
          {"state": "ACT\n3",   "lon": 149.1, "lat": -35.3, "dark": false}
        ]
      },
      "mark": {
        "type": "text",
        "font": "DM Sans",
        "fontWeight": "500",
        "fontSize": 11,
        "lineBreak": "\n"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude":  {"field": "lat", "type": "quantitative"},
        "text":      {"field": "state", "type": "nominal"},
        "color": {
          "condition": {"test": "datum.dark", "value": "#ffffff"},
          "value": "#1a1a2e"
        }
      }
    }
  ],
  "view": {"stroke": null},
  "background": "transparent",
  "config": {"font": "DM Sans"}
}
