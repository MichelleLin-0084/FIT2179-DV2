{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Donut chart of Australian natural disasters by type, 2000-2026",
  "width": "container",
  "height": 280,
  "data": {
    "values": [
      {"disaster_type": "Flood",               "count": 50},
      {"disaster_type": "Storm",               "count": 48},
      {"disaster_type": "Wildfire",            "count": 26},
      {"disaster_type": "Drought",             "count":  3},
      {"disaster_type": "Extreme temperature", "count":  3},
      {"disaster_type": "Infestation",         "count":  2},
      {"disaster_type": "Epidemic",            "count":  1}
    ]
  },
  "mark": {
    "type": "arc",
    "innerRadius": 70,
    "outerRadius": 120,
    "stroke": "#ffffff",
    "strokeWidth": 2,
    "tooltip": true
  },
  "encoding": {
    "theta": {
      "field": "count",
      "type": "quantitative"
    },
    "color": {
      "field": "disaster_type",
      "type": "nominal",
      "title": "Disaster type",
      "scale": {
        "domain": [
          "Flood",
          "Storm",
          "Wildfire",
          "Drought",
          "Extreme temperature",
          "Infestation",
          "Epidemic"
        ],
        "range": [
          "#0072B2",
          "#56B4E9",
          "#E69F00",
          "#F0E442",
          "#CC79A7",
          "#009E73",
          "#888780"
        ]
      },
      "legend": {
        "title": null,
        "orient": "right",
        "labelFontSize": 12,
        "labelFont": "DM Sans",
        "symbolSize": 120,
        "symbolType": "circle",
        "labelColor": "#3a3a4a",
        "padding": 8
      }
    },
    "tooltip": [
      {"field": "disaster_type", "type": "nominal",      "title": "Disaster type"},
      {"field": "count",         "type": "quantitative", "title": "Events"}
    ]
  },
  "view": {"stroke": null},
  "background": "transparent",
  "config": {
    "font": "DM Sans",
    "arc": {"cursor": "pointer"}
  }
}
