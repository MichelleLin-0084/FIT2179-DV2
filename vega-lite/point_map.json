{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Geocoded disaster locations across Australia (GDIS 1968-2018)",
  "width": "container",
  "height": 500,
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 750
  },
  "params": [
    {
      "name": "disaster_filter",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Flood",
          "Storm",
          "Drought",
          "Extreme Temperature",
          "Earthquake",
          "Landslide"
        ],
        "labels": [
          "All disaster types",
          "Flood",
          "Storm",
          "Drought",
          "Extreme Temperature",
          "Earthquake",
          "Landslide"
        ],
        "name": "Filter by type:  "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/alwaysblazing/Australia-State-TopoJson-MapChart/master/au-states-topo.json",
        "format": {
          "type": "topojson",
          "feature": "austates"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d6cfc4",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/gdis_australia.csv"
      },
      "transform": [
        {
          "calculate": "datum.disastertype == 'Extreme Temperature' ? 'Extreme Temperature' : datum.disastertype",
          "as": "type_clean"
        },
        {
          "filter": "disaster_filter == 'All' || datum.type_clean == disaster_filter"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.7,
        "stroke": "#ffffff",
        "strokeWidth": 0.5,
        "tooltip": true
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude":  {"field": "latitude",  "type": "quantitative"},
        "color": {
          "field": "type_clean",
          "type": "nominal",
          "title": "Disaster type",
          "scale": {
            "domain": ["Flood", "Storm", "Drought", "Extreme Temperature", "Earthquake", "Landslide"],
            "range":  ["#0072B2", "#56B4E9", "#F0E442", "#CC79A7", "#009E73", "#E69F00"]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "horizontal",
            "labelFontSize": 12,
            "labelFont": "DM Sans",
            "symbolSize": 120,
            "symbolType": "circle",
            "labelColor": "#F5F0E8",
            "padding": 8,
            "columnPadding": 16
          }
        },
        "size": {"value": 40},
        "tooltip": [
          {"field": "type_clean", "type": "nominal",      "title": "Disaster type"},
          {"field": "year",       "type": "quantitative", "title": "Year"},
          {"field": "location",   "type": "nominal",      "title": "Location"},
          {"field": "adm1",       "type": "nominal",      "title": "State"}
        ]
      }
    }
  ],
  "view": {"stroke": null},
  "background": "transparent",
  "config": {
    "font": "DM Sans",
    "legend": {
      "labelColor": "#F5F0E8",
      "titleColor": "#F5F0E8"
    }
  }
}
