{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Geocoded disaster locations across Australia (GDIS 1968-2018)",
  "width": 800,
  "height": 500,
  "background": "transparent",
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 750
  },
  "params": [
    {
      "name": "filterType",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "Flood", "Storm", "Drought", "Extreme Temperature", "Earthquake", "Landslide"],
        "labels": ["All types", "Flood", "Storm", "Drought", "Extreme Temperature", "Earthquake", "Landslide"],
        "name": "Disaster type: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/MichelleLin-0084/FIT2179-DV2/main/data/ne_1-3.json",
        "format": {"type": "topojson", "feature": "ne_10m_admin_1_states_provinces"}
      },
      "transform": [{"filter": "datum.properties.admin == 'Australia'"}],
      "mark": {
        "type": "geoshape",
        "fill": "#2a3f5f",
        "stroke": "#4a6080",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/MichelleLin-0084/FIT2179-DV2/main/data/gdis_australia.csv"
      },
      "transform": [
        {
          "filter": "filterType == 'All' || datum.disastertype == filterType"
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 100,
        "opacity": 1,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "color": {
          "field": "disastertype",
          "type": "nominal",
          "scale": {
            "domain": ["Flood", "Storm", "Drought", "Extreme Temperature", "Earthquake", "Landslide"],
            "range": ["#0072B2", "#56B4E9", "#F0E442", "#CC79A7", "#009E73", "#E69F00"]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "labelColor": "#F5F0E8"
          }
        },
        "tooltip": [
          {"field": "disastertype", "type": "nominal", "title": "Type"},
          {"field": "year", "type": "quantitative", "title": "Year"},
          {"field": "location", "type": "nominal", "title": "Location"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "DM Sans"
  }
}
